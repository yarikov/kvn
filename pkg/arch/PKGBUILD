# Maintainer: Dmitry Yarikov <dmitry@yarikov.com>
pkgname=kvn-tui
pkgver=0.29.0
pkgrel=1
pkgdesc="Terminal VPN client for Arch Linux with vim navigation"
arch=('x86_64')
url="https://github.com/yarikov/kvn-tui"
license=('MIT')
install=kvn-tui.install
depends=('gcc-libs' 'dbus' 'libcap' 'sing-box')
optdepends=(
    'wl-clipboard: clipboard integration on Wayland'
    'xclip: clipboard integration on X11 (preferred)'
    'xsel: clipboard integration on X11 (alternative)'
)
makedepends=('cargo' 'rust')
# sing-box >= 1.12 required for valid config generation
source=()
options=('!lto')
sha256sums=()

build() {
    cd "$startdir/../../"
    cargo build --release --locked
}

package() {
    cd "$startdir/../../"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    ln -s kvn-tui "$pkgdir/usr/bin/kvn"
    install -dm755 "$pkgdir/usr/lib/kvn-tui/migrations"
    for migration in contrib/migrations/*.sh; do
        [[ -f "$migration" ]] || continue
        install -m755 "$migration" "$pkgdir/usr/lib/kvn-tui/migrations/"
    done
    install -Dm644 contrib/kvn-tui.service "$pkgdir/usr/lib/systemd/user/kvn-tui.service"
    install -Dm644 contrib/kvn-tui-sing-box-capabilities.hook \
        "$pkgdir/usr/share/libalpm/hooks/kvn-tui-sing-box-capabilities.hook"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
